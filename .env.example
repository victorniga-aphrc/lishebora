# Copy to ".env" and set values. Only variables read by app/config.py are listed here.
# Omit a line to use the default in code (same as not setting the variable).

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Database ---
DATABASE_URL=postgresql://postgres@localhost:5432/lishebora
# Reference catalog (defaults match alembic layout: catalog.reference_products)
# REFERENCE_CATALOG_SCHEMA=catalog
# REFERENCE_CATALOG_PRODUCTS_TABLE=reference_products
# Minimum fuzzy name score 0–100 (SequenceMatcher). Code default is 90; set explicitly here if needed.
# REFERENCE_CATALOG_FUZZY_MIN_SCORE=90

# --- KNPM (g per 100 g or 100 ml) ---
KNPM_FAT_THRESHOLD=7.76
KNPM_SUGAR_THRESHOLD=4.7
KNPM_SODIUM_THRESHOLD=0.26

# --- Foodclasses BiLSTM (optional paths; defaults under models/) ---
FOODCLASSES_BILSTM_ENABLED=true
# FOODCLASSES_BILSTM_MODEL_PKL=models/foodclasses_model.pkl
# FOODCLASSES_BILSTM_TOKENIZER_PKL=models/tokenizer.pkl
# FOODCLASSES_BILSTM_LABEL_ENCODERS_PKL=models/label_encoders.pkl
FOODCLASSES_BILSTM_REFERENCE_WEAK_MAX_SCORE=70
NOVA_LABELS_JSON=models/nova_labels.json

# --- Healthier substitutes ---
SUBSTITUTE_RECOMMENDATIONS_ENABLED=true
SUBSTITUTE_MIN_RESULTS=3
SUBSTITUTE_MAX_RESULTS=3
SUBSTITUTE_EXPLANATION_ENABLED=true

# --- Legacy (unused by default OCR path) ---
# REPLICATE_API_TOKEN=
# REPLICATE_MODEL=openai/gpt-4.1-mini
